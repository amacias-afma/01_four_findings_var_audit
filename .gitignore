# Project specific
# Anchored to the repo root: an unanchored `data/` also matched the source package
# src/value_at_risk/data/, which therefore never reached git.
/data/*
!/data/snapshots/
# Price files come from Yahoo Finance, whose terms do not permit redistribution, so the
# CSVs stay local. The manifest (sha256, row counts, date ranges) MUST be committed:
# it is what lets a reader verify a re-download. Do not remove this negation.
/data/snapshots/*
!/data/snapshots/manifest.json
*.log

# Superseded pipeline + stale results, kept for reference only
_archive/

# LaTeX build artefacts — Overleaf los regenera en cada compilación.
# Reglas por EXTENSIÓN, no por nombre: una versión anterior listaba main.pdf y
# four-findings-*.pdf y se le escaparon v2named.* y build-named.*
paper/tex/*.aux
paper/tex/*.bbl
paper/tex/*.blg
paper/tex/*.fdb_latexmk
paper/tex/*.fls
paper/tex/*.log
paper/tex/*.out
paper/tex/*.synctex.gz
paper/tex/*.toc
paper/tex/*.pdf
paper/tex/anon.tex
paper/tex/anon.flag

/main.aux
/main.bbl
/main.blg
/main.out
/main.pdf
/main.fls
/main.fdb_latexmk
/main.synctex.gz
# Root-level LaTeX artefacts.
# main.tex lives at the repo root so Overleaf finds it; its build products must not be
# tracked. Overleaf regenerates every one on each compile, and a tracked copy is the most
# common cause of a GitHub link that "sees" the repo and then refuses to sync.
/main.aux
/main.bbl
/main.blg
/main.fdb_latexmk
/main.fls
/main.log
/main.out
/main.pdf
/main.synctex.gz
/main.toc

# Editorial strategy notes: kept locally, not published
paper/submission-plan.md
paper/tex/four-findings-supplement.zip
paper/tex/supplement-check/
